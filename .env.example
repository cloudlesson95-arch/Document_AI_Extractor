# Copy to .env (gitignored) to override a default; the full list is in backend/config.py.
# API keys belong in the OS keyring (python -m backend.app set-secret GOOGLE_API_KEY); an environment value is the fallback.
# GOOGLE_API_KEY=your-gemini-key-here

# CLOUD_PROVIDER=local                       # local | aws | azure
# SECRET_BACKEND=keyring                     # keyring | env | azure_keyvault | aws_secretsmanager
# CORS_ALLOW_ORIGINS=http://localhost:3000   # separated by spaces, not commas
# LOG_TO_FILE=true
