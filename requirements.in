# Direct dependencies with loose version ranges. requirements.txt is the lock compiled from this file:
#   uv pip compile requirements.in --universal --python-version 3.13 -o requirements.txt

# Web API
fastapi
uvicorn[standard]
python-multipart

# Validation and configuration
pydantic
python-dotenv

# HTTP and secret storage
requests
httpx
keyring

# Google Gemini
google-genai

# AWS: S3, DynamoDB and Secrets Manager (CLOUD_PROVIDER=aws)
boto3

# Azure: Blob Storage, Table Storage and Key Vault (CLOUD_PROVIDER=azure), signed in with the app's managed identity
azure-identity
azure-storage-blob
azure-data-tables
azure-keyvault-secrets
